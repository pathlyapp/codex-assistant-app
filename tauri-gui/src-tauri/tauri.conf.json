{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex 助手",
  "mainBinaryName": "codex-assistant",
  "version": "0.9.1",
  "identifier": "cn.523tech.codex.assistant",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Codex 助手",
        "width": 940,
        "height": 720,
        "minWidth": 820,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "useLocalToolsDir": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "Codex 助手"
      }
    }
  }
}
