# macOS 代码签名 + 公证配置（本地分发构建）
#
# 使用方法：复制本文件为 tauri-gui/.env.signing 并填写真实值。
# .env.signing 已被 .gitignore 忽略（匹配 .env.* 规则），不会提交到仓库。
#
# 生效范围：
#   - npm run build:mac:signed      （签名 + 公证 + 校验 + 生成 zip）
#   - npm run build:update:mac      （自动加载本配置，updater 产物一并签名）
# 环境变量优先级高于本文件。

# ---- 签名身份（可选）----
# 缺省时自动检测钥匙串中第一个 "Developer ID Application" 证书。
# 查看可用身份：security find-identity -v -p codesigning
# APPLE_SIGNING_IDENTITY=Developer ID Application: Your Name (TEAMID)

# ---- 公证方式一：App Store Connect API Key（推荐，与 deeppath 一致）----
# 在 App Store Connect → 用户与访问 → 集成 → App Store Connect API 创建密钥（Developer 角色）
# APPLE_API_ISSUER：密钥列表上方的 Issuer ID
# APPLE_API_KEY：密钥的 Key ID
# APPLE_API_KEY_PATH：下载的 .p8 私钥文件路径（绝对路径，或相对 tauri-gui/ 的路径；
#                     也可不设置，将 AuthKey_<KeyID>.p8 放入 ~/private_keys 等默认目录）
APPLE_API_ISSUER=
APPLE_API_KEY=
APPLE_API_KEY_PATH=

# ---- 公证方式二：Apple ID + App 专用密码（与方式一二选一即可）----
# App 专用密码在 https://appleid.apple.com 的「登录与安全 → App 专用密码」生成
# APPLE_ID=you@example.com
# APPLE_PASSWORD=xxxx-xxxx-xxxx-xxxx
# APPLE_TEAM_ID=R6W985647L
